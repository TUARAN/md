{
  "manifest_version": 3,
  "name": "csync",
  "short_name": "csync",
  "version": "1.0.4",
  "description": "csync：与 Markdown 编辑器联动的多平台同步扩展，侧重知乎、公众号、微博等。其它平台可配合 COSE 扩展使用。",
  "action": {
    "default_icon": "assets/logo-48.png",
    "default_popup": "dist/popup/index.html"
  },
  "background": {
    "service_worker": "dist/background/index.mjs"
  },
  "icons": {
    "16": "assets/logo-16.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "tabs",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*.csdn.net/*",
        "https://*.csdn.net/*",
        "https://syncblog.cn/*",
        "https://www.syncblog.cn/*",
        "https://*.syncblog.cn/*",
        "https://md.doocs.org/*",
        "https://*.doocs.org/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["dist/content/web-api.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/contentScripts/index.global.js"],
      "run_at": "document_end"
    }
  ],
  "externally_connectable": {
    "matches": [
      "*://*.csdn.net/*",
      "*://csdn.net/*",
      "https://syncblog.cn/*",
      "https://*.syncblog.cn/*",
      "https://md.doocs.org/*",
      "https://*.doocs.org/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/contentScripts/style.css", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
