{
  "name": "md",
  "type": "module",
  "version": "2.1.0",
  "private": false,
  "packageManager": "pnpm@10.15.0",
  "description": "博主联盟同步工具 — 全链路内容运营工作流，当前阶段聚焦内容分发与同步（Markdown 编辑、渲染与多渠道同步）。",
  "homepage": "https://syncblog.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/TUARAN/md"
  },
  "bugs": {
    "url": "https://github.com/TUARAN/md/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "pnpm web dev",
    "deploy:cloudflare": "bash ./scripts/deploy-cloudflare.sh",
    "web": "pnpm --filter @md/web",
    "vscode": "pnpm --prefix ./apps/vscode",
    "mcp": "pnpm --filter @md/mcp-server",
    "cli": "pnpm --filter @doocs/md-cli",
    "build:cli": "pnpm web build && npx shx rm -rf packages/md-cli/dist && npx shx rm -rf dist/**/*.map && npx shx cp -r apps/web/dist packages/md-cli/ && cd packages/md-cli && npm pack",
    "release:cli": "node ./scripts/release.js",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --build --force",
    "postinstall": "simple-git-hooks",
    "inspector": "pnpx node-modules-inspector",
    "utools:package": "node ./scripts/package-utools.mjs",
    "package:csync": "node ./scripts/package-csync-extension.mjs"
  },
  "dependencies": {
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.42.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@types/node": "^25.7.0",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "2.8.8",
    "shx": "^0.4.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
