{
  "name": "syncblog",
  "type": "module",
  "version": "2.2.0",
  "private": false,
  "packageManager": "pnpm@10.15.0",
  "description": "Syncblog — 一文多发，30 分钟完成 30+ 平台同步。面向博主与创作团队的全链路内容运营工作流，当前阶段聚焦 Markdown 编辑、渲染与多平台分发同步。",
  "homepage": "https://syncblog.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/TUARAN/md"
  },
  "bugs": {
    "url": "https://github.com/TUARAN/md/issues"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "pnpm web dev",
    "deploy:cloudflare": "bash ./scripts/deploy-cloudflare.sh",
    "web": "pnpm --filter @md/web",
    "vscode": "pnpm --prefix ./apps/vscode",
    "mcp": "pnpm --filter @md/mcp-server",
    "cli": "pnpm --filter @doocs/md-cli",
    "build:cli": "pnpm web build && npx shx rm -rf packages/md-cli/dist && npx shx rm -rf dist/**/*.map && npx shx cp -r apps/web/dist packages/md-cli/ && cd packages/md-cli && npm pack",
    "release:cli": "node ./scripts/release.js",
    "lint": "eslint . --fix",
    "type-check": "pnpm --filter @md/web type-check",
    "postinstall": "simple-git-hooks",
    "inspector": "pnpx node-modules-inspector",
    "utools:package": "node ./scripts/package-utools.mjs"
  },
  "dependencies": {
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@types/node": "^25.9.1",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-format": "^2.0.1",
    "npm-run-all2": "^9.0.0",
    "prettier": "2.8.8",
    "shx": "^0.4.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm web type-check && pnpm run lint"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
